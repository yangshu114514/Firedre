---
import RegisterCard from "@/components/auth/RegisterCard.svelte";
import Layout from "@/layouts/Layout.astro";
import { cfEnv } from "../lib/api";
import { getAuthUser } from "@server/auth/userSession";

// 已登录用户无需注册
const me = await getAuthUser(Astro.request, cfEnv);
if (me) return Astro.redirect("/profile/");

const turnstileSiteKey: string =
	(import.meta.env.VITE_TURNSTILE_SITE_KEY as string | undefined) ?? "";

const title = "注册账号";
const description = "注册 Firedre 账号，验证邮箱后参与评论与互动";
---

{/* 独立页：只用裸 Layout（无导航栏 / 无侧边栏 / 无页脚），内容为居中卡片 */}
<Layout title={title} description={description}>
	<main class="auth-standalone">
		<a href="/" class="auth-standalone__back">← 返回首页</a>
		<RegisterCard client:load turnstileSiteKey={turnstileSiteKey} />
	</main>
</Layout>

<style>
	.auth-standalone {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		padding: 2.5rem 1rem;
	}
	.auth-standalone__back {
		font-size: 0.875rem;
		opacity: 0.6;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.auth-standalone__back:hover {
		opacity: 1;
		color: var(--primary);
	}
</style>
