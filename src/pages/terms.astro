---
import "@/styles/pages/common.css";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// Firedre：用户协议为独立路由（不进文章列表），内容来自 R2 spec/terms.md（后台「页面管理」可编辑）
const { getSpecPage } = await import("@server/spec/service");
const { cfEnv } = await import("../lib/api");

let termsHtml = "";
try {
	termsHtml = (await getSpecPage(cfEnv, "terms"))?.html || "";
} catch {
	termsHtml = "";
}

const title = "用户协议";
const description = "使用本站前请仔细阅读以下协议条款。";
---

<MainGridLayout title={title} description={description}>
  <div
    class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
  >
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <div class="mb-8">
        <div class="page-heading">
          <div class="page-icon" aria-hidden="true">
            <Icon name="material-symbols:docs" />
          </div>
          <div>
            <h2>{title}</h2>
            <p>{description}</p>
          </div>
        </div>
      </div>

      <Markdown class="mt-2">
        {termsHtml ? (
          <Fragment set:html={termsHtml} />
        ) : (
          <p class="text-neutral-500 dark:text-neutral-400">暂无用户协议内容，请在后台「页面管理」中填写。</p>
        )}
      </Markdown>
    </div>
  </div>
</MainGridLayout>
