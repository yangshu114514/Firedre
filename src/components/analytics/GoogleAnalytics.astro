---
import { jsonForScript } from "@/utils/csp-json";

interface Props {
	analyticsId: string;
}

const { analyticsId } = Astro.props;
---

<script is:inline data-swup-ignore-script async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>
<script type="application/json" set:html={jsonForScript({ analyticsId })} />
<script is:inline data-swup-ignore-script>
(function() {
const { analyticsId } = JSON.parse(document.currentScript.previousElementSibling.textContent);
window.dataLayer = window.dataLayer || [];

function gtag() {
    dataLayer.push(arguments);
}

gtag('js', new Date());
gtag('config', analyticsId);
})();
</script>
