---
import { jsonForScript } from "@/utils/csp-json";

interface Props {
	clarityId: string;
}

const { clarityId } = Astro.props;
---

<script type="application/json" set:html={jsonForScript({ clarityId })} />
<script is:inline data-swup-ignore-script>
    (function() {
    const { clarityId } = JSON.parse(document.currentScript.previousElementSibling.textContent);
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", clarityId);
    })();
</script>
